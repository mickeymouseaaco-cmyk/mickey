{
  "expo": {
    "name": "Together",
    "slug": "together",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "together",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "app.together.couple",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EFFB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.together.couple"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#16141B"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Together uses your microphone only while you record a voice note, voice hug, or private vent."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Together only sees the photos you choose to send or add to your Memory Jar.",
          "cameraPermission": "Together uses your camera only when you choose to take a photo to share."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to keep Together private to you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6A4C9C"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-video",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "KindWord",
              "displayName": "Kind word",
              "description": "The latest kind word from your partner.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
